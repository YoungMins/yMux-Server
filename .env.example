# Copy to .env (git-ignored) and edit. Read by docker compose.

# --- docker-compose.yml (you already have a reverse proxy or a tunnel) ---

# The https address people reach the server at, exactly as typed into yMux and the phone.
# No path, no trailing slash. Must match the proxy's public name, or WebSockets are refused
# (origin_mismatch).
YMUX_SERVER_PUBLIC_URL=https://remote.example.com

# Where the server port is published on this host. 127.0.0.1 = only a proxy on this same
# machine can reach it. Set 0.0.0.0 ONLY when the proxy runs on another machine, and then
# firewall the port to that machine: the port speaks plain HTTP and trusts X-Forwarded-For
# (YMUX_SERVER_TRUST_PROXY), so anyone who can reach it directly can fake their address.
#YMUX_SERVER_PUBLISH=127.0.0.1

# Host port to publish (the container always listens on 11020).
#YMUX_SERVER_PORT=11020

# 1 = take the client address from the proxy's X-Forwarded-For (right for any proxy that
# overwrites or appends it). Set 0 if nothing is in front of the server.
#YMUX_SERVER_TRUST_PROXY=1

# --- docker-compose.caddy.yml (Caddy gets the certificate; the public URL is derived) ---

# DNS name pointing at this machine, no scheme.
#YMUX_DOMAIN=remote.example.com
